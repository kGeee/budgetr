<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- CloudKit entitlements removed: free personal teams don't support iCloud/Push.
	     Re-add with a paid Apple Developer account:
	       com.apple.developer.icloud-container-identifiers → iCloud.com.budgetr.app
	       com.apple.developer.icloud-services → CloudKit
	       aps-environment → development
	     Also restore NSPersistentCloudKitContainer in PersistenceController.swift. -->

	<!-- macOS sandbox: required for App Store; lets the app reach the network. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Reading a ledger the user picked.
	     Without this a sandboxed app cannot open ANY file chosen through the
	     document picker: the panel appears, the user selects budgetr.db, and
	     every read is denied by the sandbox. The first-run import worked only
	     because that file sits inside the app's own container, which never
	     needs an entitlement. Read-only, because the importer never writes to
	     the ledger it reads. -->
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
</dict>
</plist>
